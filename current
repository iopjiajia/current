% =========================================================================
\section{待测样品与前置核查材料}
% =========================================================================

\begin{checklist}
\item \textbf{待测第二代高温超导（2G-HTS）短带材}
  \begin{checklist}
  \item \textbf{规格要求：}铜或铜合金封装带材；宽度 $2\text{--}15\,\mathrm{mm}$，厚度 $0.1\text{--}0.5\,\mathrm{mm}$；临界电流 $\Ic < 500\,\mathrm A$（若超过 $500\,\mathrm A$ 需更大恒流源并严格监控接触电阻与电源限压）；$n$ 值 $> 5$；液氮温度下过流能力 $\ge 1.5\,\Ic$。
  \item \textbf{禁用项：}本方法\textbf{不适用于表面涂覆绝缘层}的超导带材。
  \end{checklist}
\end{checklist}

% =========================================================================
\section{四引线夹具与电极接触材料}
% =========================================================================

\begin{checklist}
\item \textbf{纯铜电流引线电极（2 块）与纯铜电压引线电极（2 块）}
  \begin{checklist}
  \item 采用平面压接形式（与样带接触面为平面）；建议适当增大电流电极体积以增加热容，抑制局部温升。
  \item 电极尺寸须满足几何下限：电流电极接触长度 $L_4 >$ 带材宽度，电流与电压电极最小间距 $L_3 \ge$ 带材宽度（如出现电流转移“爬坡”须进一步增大 $L_3$）。
  \end{checklist}
\item \textbf{铜编织带与铜编织套}
  \begin{checklist}
  \item \textbf{铜编织带：}用作大电流主引线，提升液氮中的散热效率。
  \item \textbf{铜编织套：}垫装在电流压接电极与超导带材之间，增大有效通流接触面积、显著降低接触电阻并改善散热（见附录图~A.7、图~A.8）。
  \end{checklist}
\item \textbf{绝缘样品支架与可控压接施力机构（压头/压板）}
  \begin{checklist}
  \item 平直支撑超导带材并实现可靠电隔离。
  \item 施压机构须能精确控制压紧力，保证纯铜电极与带材之间的\textbf{接触压强} $\le 35\,\mathrm{MPa}$，避免压伤或折弯带材。
  \end{checklist}
\item \textbf{细砂纸}
  \begin{checklist}
  \item 每次测试前用于打磨纯铜电流、电压电极接触表面，使其干净、光亮，以降低界面接触电阻。
  \end{checklist}
\item \textbf{电压测量引线}
  \begin{checklist}
  \item \textbf{主测压引线（1 对）：}连接两纯铜电压电极至纳伏表，测量测试段压降 $U$。
  \item \textbf{接触电阻监测引线（2 对）：}分别接在左、右电流压接电极与紧邻电极内侧的带材表面，用于测量两端接触电阻与损耗功率（对应附录图~A.7 中的 $V_1, V_2$）。
  \end{checklist}
\end{checklist}

% =========================================================================
\section{低温冷却与干燥存放材料及设备}
% =========================================================================

\begin{checklist}
\item \textbf{低温槽（液氮杜瓦，1 个）}
  \begin{checklist}
  \item 内外腔通常采用无磁不锈钢并填充隔热层，具备良好绝热与恒温性能。
  \item 容积须能将整套四引线压接组件完全浸没，并保证{液氮液面高于组件最高点} $\ge 3\,\mathrm{cm}$；方便手动或自动补液（有条件宜配液面监测装置与底部内壁加热系统）。
  \end{checklist}
\item \textbf{液氮冷剂及补液转移用具}
  \begin{checklist}
  \item 满足一个标准大气压、稳定液氮浴（$76.5\,\mathrm K \le T \le 77.8\,\mathrm K$）测试需求。
  \end{checklist}
\item \textbf{低温温度探头（1 支）}
  \begin{checklist}
  \item 布置于带材测试段附近，实时测量并记录液氮冷剂温度。
  \end{checklist}
\item \textbf{控温烘干箱（1 台，控温范围 $50^\circ\mathrm C\text{--}150^\circ\mathrm C$）}
  \begin{checklist}
  \item 测前用于预热烘干带材，防止水汽进入液氮结冰影响通流；测后用于充分回温烘干，防止表面凝露。
  \item \textbf{注意：}严禁使用热风枪、高温焊枪等不受控热源替代。
  \end{checklist}
\item \textbf{干燥存放盒 / 干燥柜}
  \begin{checklist}
  \item 测后存放带材，保证远离潮气、水分，且避免堆叠挤压、刮擦或过度弯折。
  \end{checklist}
\end{checklist}

% =========================================================================
\section{核心电测、采集与接触监控设备}
% =========================================================================

\begin{checklist}
\item \textbf{直流恒流源（1 台）}
  \begin{checklist}
  \item 输出电流稳定性须{优于 $1\%$}，量程覆盖待测 $\Ic$ 及余量。
  \item 支持{恒定速率升流}（$0 \to \Ic$ 耗时 $> 10\,\mathrm s$；未知 $\Ic$ 首测速率 $< 5\,\mathrm{A/s}$）或{升流-恒流-升流}模式（恒流点漂移 $< 1\%\,\Ic$）。
  \item 具备{输出电压上限}调节功能及软件{截止电压}控制，用于保护电源免受高阻或断路冲击。
  \end{checklist}
\item \textbf{高分辨率纳伏表（1 台）}
  \begin{checklist}
  \item 分辨率须{达到 $1\,\mathrm{nV}$ 及以上}（附录评定示例采用 $10\,\mathrm{mV}$ 量程纳伏表），用于采集测试段电压 $U$。
  \end{checklist}
\item \textbf{四引线标准电阻（分流器）与数字万用表（若采用分流器法测电流）}
  \begin{checklist}
  \item 标准电阻精确度不低于 $0.5\%$（附录示例阻值 $0.25\,\mathrm{m}\Omega$），配合数字万用表（如 $100\,\mathrm{mV}$ 量程）精确测定输运电流 $I$。
  \end{checklist}
\item \textbf{接触电阻与电极温升监控组件}
  \begin{checklist}
  \item {接触电阻监测电压表（2 路或双通道采集，对应附录图~A.7 中的 $V_1, V_2$）：}用于测前自检与升流全程实时读取左、右电流压接处的接触压降，换算接触电阻与损耗功率。
  \item {测温热电偶（安装于电流引线电极附近）：}监控接触电阻焦耳热引起的局部温升，\textbf{温升达到 $1\,\mathrm K$ 时须停止加电}（见标准第~6.3.1~节与附录~A.4.4）。
  \end{checklist}
\item \textbf{计算机、测试软件与控制总线接口}
  \begin{checklist}
  \item 用于自动控制升流、同步记录完整 $U\text{--}I$ 曲线及 $V_1, V_2$ 数据、计算 $\Ic$ 与 $n$ 值，并在接触异常或超温时及时降流停机。
  \end{checklist}
\end{checklist}

% =========================================================================
\section{计量与安全防护辅助工具}
% =========================================================================

\begin{checklist}
\item \textbf{长度测量工具（游标卡尺或钢直尺）}
  \begin{checklist}
  \item 最小刻度须 $\le 1\,\mathrm{mm}$，用于精确量测电压引线间距 $L_2$ 及 $L_3, L_4, L_5$（直接影响判据电压 $\Uc = L_2 \Ec$ 与不确定度）。
  \end{checklist}
\item \textbf{低温与电气安全防护用品}
  \begin{checklist}
  \item 低温防冻手套、护目镜等（落实标准开篇“重要提示”的安全防护要求）。
  \end{checklist}
\end{checklist}

